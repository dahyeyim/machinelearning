    "#경위도 value\n",
    "\n",
    "def latitude_(i):\n",
    "    latitude = KL.search_address(csv_test['도로명주소'][i])['documents'][0]['y']\n",
    "    return latitude \n",
    "\n",
    "def longitude_(i):\n",
    "    longitude = KL.search_address(csv_test['도로명주소'][i])['documents'][0]['x']\n",
    "    return longitude\n",
    "\n",
    "\n",
    "address = csv_test['도로명주소']\n",
    "\n",
    "latitude = []\n",
    "longitude =[]\n",
    "\n",
    "for i in range(0, len(csv_test)):\n",
    "    latitude.append(latitude_(i))\n",
    "    longitude.append(longitude_(i))\n",
    "\n",
    "df_address = pd.DataFrame({'도로명주소':csv_test['도로명주소'],'위도':latitude,'경도':longitude})\n",
    "df_address[['도로명주소', '경도', '위도']]\n"
