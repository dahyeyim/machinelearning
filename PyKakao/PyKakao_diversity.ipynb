    " \n",
    "def keyword(query, category_group_code, i):\n",
    "    query\n",
    "    category_group_code                                            # 카페\n",
    "    x, y = df_address['경도'][i], df_address['위도'][i]             # 중심 좌표\n",
    "    radius = 500                                                    # 반경거리(m)\n",
    "    result = KL.search_keyword(query, category_group_code, x, y, radius)\n",
    "    return result\n"
