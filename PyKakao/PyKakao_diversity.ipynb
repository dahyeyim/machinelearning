    "\n",
    "#데이터 불러오기 (mac/windows)\n",
    "csv_test = pd.read_csv('/Volumes/GoogleDrive/내 드라이브/0. code/kakaomap/PyKakao/test.csv', encoding='cp949', engine='python')   # '도로명주소' 포함된 데이터 넣기 \n",
